<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- pressed: key sinks, shadow shrinks -->
            <item android:left="3dp" android:right="3dp" android:top="5dp" android:bottom="3dp">
                <shape>
                    <solid android:color="?attr/keyShadowColor" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="3dp" android:right="3dp" android:top="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="?attr/keyNormalPressed" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- soft drop shadow for a raised 3D look -->
            <item android:left="3dp" android:right="3dp" android:top="6dp" android:bottom="2dp">
                <shape>
                    <solid android:color="?attr/keyShadowColor" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="3dp" android:right="3dp" android:top="4dp" android:bottom="5dp">
                <shape>
                    <solid android:color="?attr/keyNormal" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#80FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
